{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maquinaativos",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Frontend estático no MESMO Worker. API e rotas públicas passam primeiro pelo código; o resto é arquivo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pub/*", "/saude"]
  },
  // Turnstile (opcional): `wrangler secret put TURNSTILE_SECRET` e defina TURNSTILE_SITEKEY aqui.
  "vars": { "TURNSTILE_SITEKEY": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maquina",
      // Depois de `wrangler d1 create maquina`, cole aqui o database_id que ele devolver.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    { "name": "maquina-caso", "binding": "CASO_WF", "class_name": "CasoWorkflow" }
  ]
  // Segredo de escrita: `wrangler secret put API_TOKEN` (local: apps/runtime/.dev.vars).
}
